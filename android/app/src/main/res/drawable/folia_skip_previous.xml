  这里按 lucide 的 24x24 网格重画成矢量：尖朝左的三角 + 左侧一条竖杠。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M19,5 L19,19 L9,12 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M4,5 L6,5 L6,19 L4,19 Z" />
