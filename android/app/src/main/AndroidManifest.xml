<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- 后台播放的前台服务：进程拿到前台优先级后，WebView 里的 fetch 才不会被
             后台节流挂住（自动切下一首拿不到歌曲地址的根因）。
             foregroundServiceType="mediaPlayback" 是 Android 14+ 的强制要求。 -->
        <service
            android:name=".FoliaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- 通知栏/锁屏/耳机的播放指令。清单注册而非 Activity 动态注册：
             后台被点通知栏时 Activity 未必还在，动态接收器收不到指令。 -->
        <receiver android:name=".FoliaCommandReceiver" android:exported="false">
            <intent-filter>
                <action android:name="top.izuna.foliamajor.action.WEB_COMMAND" />
            </intent-filter>
        </receiver>

        <!-- 让 MediaSession 的控制按钮（通知栏、锁屏、蓝牙耳机）能把应用唤到前台 -->
        <receiver android:name="androidx.media.session.MediaButtonReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- 崩溃取证界面：开发机上没有 adb 设备，只能让 App 自己把栈显示出来 -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:label="崩溃信息"
            android:theme="@style/AppTheme.NoActionBar" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务 + 通知：后台播放时占住前台优先级并在通知栏显示播放控制 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
