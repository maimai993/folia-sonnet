<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".FoliaApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <!-- Lyricon 状态栏歌词：声明本应用是一个歌词提供端。缺 `lyricon_module` 时
             Lyricon 不会把本应用当成模块，App 里开了开关也推不出去。 -->
        <meta-data android:name="lyricon_module" android:value="true" />
        <meta-data android:name="lyricon_module_author" android:value="Folia" />
        <meta-data android:name="lyricon_module_description" android:value="Folia 音乐播放器：当前歌曲与逐行歌词" />
        <meta-data android:name="lyricon_module_tags" android:resource="@array/lyricon_module_tags" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- 后台播放的前台服务：进程拿到前台优先级后，WebView 里的 fetch 才不会被
             后台节流挂住（自动切下一首拿不到歌曲地址的根因）。
             foregroundServiceType="mediaPlayback" 是 Android 14+ 的强制要求。 -->
        <service
            android:name=".FoliaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- 通知栏/锁屏/耳机的播放指令。清单注册而非 Activity 动态注册：
             后台被点通知栏时 Activity 未必还在，动态接收器收不到指令。 -->
        <receiver android:name=".FoliaCommandReceiver" android:exported="false">
            <intent-filter>
                <action android:name="top.izuna.foliamajor.action.WEB_COMMAND" />
            </intent-filter>
        </receiver>

        <!-- 让 MediaSession 的控制按钮（通知栏、锁屏、蓝牙耳机）能把应用唤到前台 -->
        <receiver android:name="androidx.media.session.MediaButtonReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- 歌词动态壁纸。BIND_WALLPAPER 权限 + 这个 intent-filter 是系统认领动态壁纸的
             硬性要求，缺任一个它都不会出现在壁纸选择器里。 -->
        <service
            android:name=".wallpaper.LyricsWallpaperService"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/lyrics_wallpaper" />
        </service>

        <!-- 崩溃取证界面：开发机上没有 adb 设备，只能让 App 自己把栈显示出来 -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:label="崩溃信息"
            android:theme="@style/AppTheme.NoActionBar" />

        <!--
            音乐锁屏页：系统正式支持的「画在锁屏之上」只能靠 Activity
            （悬浮窗那条路各家 ROM 说了算，见 LockScreenMusicActivity 的说明）。

            showWhenLocked 是清单里的前置声明，代码里的 setShowWhenLocked 是 API 27+ 的开关，
            两个都要有。excludeFromRecents / taskAffinity="" 让它不污染最近任务与返回栈，
            否则用户解锁后会发现多出来一个「Folia 锁屏」卡片。

            这里**不能**加 android:noHistory="true"：它的语义是"用户一旦离开就 finish"，
            而锁屏这个场景里"离开"的判定很微妙（keyguard 重新布局、被其它锁屏界面遮挡
            都算），用户什么都没做，Activity 就被系统自己 finish 了 ——
            表现正是「闪出播放界面，然后突然消失」。不进历史记录靠 excludeFromRecents 就够了。
        -->
        <activity
            android:name=".LockScreenMusicActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:theme="@style/LockScreenTheme" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务 + 通知：后台播放时占住前台优先级并在通知栏显示播放控制 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
        本地曲库扫描：读系统媒体库里的音频必须声明这两个权限，缺了的话
        Capacitor 的 requestPermissionForAlias 会直接判"拒绝"，扫描按钮点了没反应。
        13+ 用 READ_MEDIA_AUDIO，12 及以下用 READ_EXTERNAL_STORAGE（maxSdkVersion 限住，
        两个不能混在同一个别名里申请，见 FoliaNativePlugin.audioPermissionAlias 的说明）。
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!--
        所有文件访问（MANAGE_EXTERNAL_STORAGE）：媒体库扫不到的歌（有的 ROM 不收录、
        用户音乐放在 Download/Music 之外的角落）靠它做文件系统兜底扫描。
        这是"受限权限"，不能靠弹窗给，只能跳系统设置让用户手动开 —— 见
        FoliaNativePlugin.requestAllFilesAccess。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!--
        壁纸的可视化叠层：WallpaperService 本身只能往 Surface 上画 GLES，
        画不了 PixiJS 那套可视化，所以要在壁纸之上叠一个 WebView 窗口来跑同一套渲染代码。
        属于「用户必须手动授权」的权限（设置 → 应用 → 显示在其他应用上层）。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
</manifest>
