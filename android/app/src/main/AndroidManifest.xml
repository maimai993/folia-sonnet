<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        把自己申报成「游戏」（appCategory），让系统把它当成渲染密集的应用。

        为什么音乐播放器要这么做：歌词壁纸、壁纸叠层、各类可视化都是贴着壁纸 Surface
        按帧跑的（原生 GLES / WebGL），和游戏是同一种负载——掉帧就是肉眼可见的顿挫。

        appCategory="game" 的作用不是让 AOSP 直接提频（AOSP 只拿它做分类统计与耗电归因），
        而是让 ROM 的游戏管线认得这个包：各家的游戏助手 / Game Dashboard 按它决定要不要
        给出「性能模式」，adb 的 `cmd game mode performance <pkg>` 也要求先声明成游戏才认。

        isGame 是 API 21 的老写法，API 33 起标记废弃但在 manifest 里仍然合法；留着是因为
        部分 ROM 的老识别逻辑还在读它。两个一起给，覆盖面最广。

        注意：这里没有加那条 android.game_mode_config 的 meta-data。官方那条配置的含义是
        「由应用自己响应 PERFORMANCE / BATTERY 模式并实现优化」，一旦声明，平台会把 OEM
        原本自动施加的游戏模式干预重置掉——那正是我们想白拿的那部分。不声明则 OEM 的
        兜底干预继续生效，更符合「让系统多给点调度」。

        代价：部分 ROM 会把它收进「游戏空间」，前台时出现游戏助手悬浮球 / 免打扰；
        上 Google Play 时类别会落到「游戏」（本项目是自用发布，不走 Play）。
    -->
    <!--
        包可见性：让「跳到厂商的省电 / 自启动设置页」真的能跳过去。

        Android 11 起，`Intent.resolveActivity` 对没声明过的包一律返回 null，
        显式 `startActivity` 到不可见的组件也会抛 ActivityNotFoundException ——
        两个失败都是**静默**的（只是没跳过去），表现就是「点了没反应」。
        保活引导（keepalive/KeepAlive）与锁屏引导（lockscreen/RomPermissionGuide）
        都靠这一张表才认得那些厂商页面。

        只列会在候选表里出现的包，不用 QUERY_ALL_PACKAGES：后者是"能看见所有应用"，
        会被应用市场判为过度授权，而我们只需要看这几家的设置页。
        新增候选时**这张表要同步加** —— 漏了不会报错，只会静默退到应用详情页。
    -->
    <queries>
        <!-- 小米 / Redmi / POCO：安全中心（自启动）、电量和性能（耗电管理） -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <!-- 华为 / 荣耀：手机管家 -->
        <package android:name="com.huawei.systemmanager" />
        <!-- vivo / iQOO -->
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <!-- OPPO / 一加 / realme：手机管家、电池 -->
        <package android:name="com.oplus.safecenter" />
        <package android:name="com.oplus.battery" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.coloros.securitypermission" />
        <package android:name="com.coloros.oppoguardelf" />
        <package android:name="com.coloros.powermanager" />
        <package android:name="com.oneplus.security" />
        <!-- 三星：设备维护 -->
        <package android:name="com.samsung.android.lool" />
        <!-- 魅族：手机管家 -->
        <package android:name="com.meizu.safe" />
    </queries>

    <application
        android:name=".FoliaApplication"
        android:allowBackup="true"
        android:appCategory="game"
        android:isGame="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <!-- Lyricon 状态栏歌词：声明本应用是一个歌词提供端。缺 `lyricon_module` 时
             Lyricon 不会把本应用当成模块，App 里开了开关也推不出去。 -->
        <meta-data android:name="lyricon_module" android:value="true" />
        <meta-data android:name="lyricon_module_author" android:value="Folia" />
        <meta-data android:name="lyricon_module_description" android:value="Folia 音乐播放器：当前歌曲与逐行歌词" />
        <meta-data android:name="lyricon_module_tags" android:resource="@array/lyricon_module_tags" />

        <!--
            ColorOS 原生锁屏歌词：声明本应用愿意进 OPlus 的 media-history / 媒体管线。
            部分 ColorOS 会在媒体会话进入 OPlus 管线之前按包过滤，缺了这条声明
            SystemUI 可能根本看不到我们的 MediaSession。

            它只影响 OPlus 的媒体历史 / 黑名单策略，**不会**生成歌词、也不会把 App 加进
            任何 Xposed 模块的作用域 —— 歌词仍然由我们自己写进 MediaMetadata["lyricInfo"]。
            （对应 ColorOS-Live-Lyrics-Bridge 协议里的 OPLUS_MEDIA_HISTORY。）
        -->
        <meta-data
            android:name="io.github.andrealtb.lockscreenlyrics.OPLUS_MEDIA_HISTORY"
            android:value="true" />

        <!--
            厂商「全屏显示 / 刘海」适配（注册给 ROM 看的部分）。

            有用户反馈屏幕顶部有黑边：框架侧的缺省行为是把内容顶到挖孔下方，而部分厂商
            （MIUI / EMUI / ColorOS 一类）在设置里给每个应用留了一个「允许应用全屏显示」开关，
            按下面这些 meta-data 判断这个应用支不支持铺满。没声明的应用会被当成「不支持」，
            于是被 letterbox 成一条黑边 —— 缺的就是这份「注册」。

            运行时那一份（PhoneFitCutout.apply 设 layoutInDisplayCutoutMode + 清 inset padding）
            管的是窗口创建之后的铺开，这里管的是 ROM 的白名单与开屏那一帧，两边都要有。

            注：不要给 activity 加 android:maxAspectRatio。那是「最大」长宽比，声明得比屏幕
            小时反而会被系统加黑边（例如折叠屏 / 21:9）；targetSdk 26+ 不声明就是铺满。
        -->
        <!-- 通用：本应用支持的最大屏幕长宽比（> 常见 18:9=2.0），各 ROM 的识别依据。 -->
        <meta-data android:name="android.max_aspect" android:value="2.4" />
        <!-- MIUI / HyperOS：刘海区域的显示配置（竖屏与横屏都铺到刘海两侧）。 -->
        <meta-data android:name="notch.config" android:value="portrait|landscape" />
        <!-- EMUI / HarmonyOS：声明本应用已做刘海适配，不再强制下移内容。 -->
        <meta-data android:name="android.notch_support" android:value="true" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                外部来的音频（用 Folia 打开 / 分享到 Folia）。

                注册了这些过滤器，用户在任何文件管理器里点一个音频文件，"打开方式"里才会出现
                Folia；没注册之前系统只在 Browse documents 那一类裁剪过的意图里考虑它。

                三条路都得留：
                · VIEW + content://audio/* —— 绝大多数文件管理器走这条；
                · VIEW + content:// + 非标 mime —— 个别 ROM 把 flac/ogg 报成 application/*
                  而不是 audio/*，只认 audio/* 就会出现「点了没反应」；
                · VIEW + file:// + 后缀 —— 老的管理器只给文件路径（有时连 mime 都懒得给）。

                后缀取樱 App 能真的播的那批（与 KNOWN_AUDIO_EXTENSIONS 同源）：
                mp3 / flac / m4a / aac / alac / wav / ogg / opus / ape / wv / tta / wma / aif / aiff / caf。

                收到之后不是直接入库：MainActivity.handleIncomingAudioIntent 把 uri 交给
                FoliaNativePlugin 拷进 App 私有目录，再由 Web 层问「导入到哪个歌单」
                （ExternalAudioImportHost，复制 Maxwell 用户自己确认这一步）。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/ogg" />
                <data android:scheme="content" android:mimeType="application/x-flac" />
                <data android:scheme="content" android:mimeType="application/flac" />
                <data android:scheme="content" android:mimeType="application/x-ogg" />
                <data android:scheme="content" android:mimeType="application/aac" />
                <data android:scheme="content" android:mimeType="application/x-wav" />
                <data android:scheme="content" android:mimeType="application/mp3" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.mp3" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.flac" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.m4a" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.aac" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.alac" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.wav" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.ogg" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.opus" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.ape" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.wv" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.tta" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.wma" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.aif" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.aiff" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.caf" />
            </intent-filter>
            <!-- 分享：从别的 App 把音频「分享」给 Folia，进来的是 EXTRA_STREAM。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-flac" />
                <data android:mimeType="application/flac" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- 后台播放的前台服务：进程拿到前台优先级后，WebView 里的 fetch 才不会被
             后台节流挂住（自动切下一首拿不到歌曲地址的根因）。
             foregroundServiceType="mediaPlayback" 是 Android 14+ 的强制要求。 -->
        <service
            android:name=".FoliaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- 通知栏/锁屏/耳机的播放指令。清单注册而非 Activity 动态注册：
             后台被点通知栏时 Activity 未必还在，动态接收器收不到指令。 -->
        <receiver android:name=".FoliaCommandReceiver" android:exported="false">
            <intent-filter>
                <action android:name="top.izuna.foliamajor.action.WEB_COMMAND" />
            </intent-filter>
        </receiver>

        <!-- 让 MediaSession 的控制按钮（通知栏、锁屏、蓝牙耳机）能把应用唤到前台 -->
        <receiver android:name="androidx.media.session.MediaButtonReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- 歌词动态壁纸。BIND_WALLPAPER 权限 + 这个 intent-filter 是系统认领动态壁纸的
             硬性要求，缺任一个它都不会出现在壁纸选择器里。 -->
        <service
            android:name=".wallpaper.LyricsWallpaperService"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/lyrics_wallpaper" />
        </service>

        <!-- 崩溃取证界面：开发机上没有 adb 设备，只能让 App 自己把栈显示出来 -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:label="崩溃信息"
            android:theme="@style/AppTheme.NoActionBar" />

        <!--
            YouTube Music 登录：单独一座装 WebView 的 Activity。

            为什么不能在主界面那个 WebView 里登录：把它导航到 accounts.google.com 等于把整个
            应用页面换掉；而 Chrome Custom Tab 的 cookie 落在 Chrome 自己的罐里，我们读不到。
            登录完由它把 youtube.com 的 cookie 经 FoliaYtm 交回 Web 层 —— 凭据只能是 cookie，
            因为 YouTube 没有给 YouTube Music 的 OAuth。

            不进最近任务：它是登录流程里的一步，不是用户可以自己切回去的一个「页面」。
            不给 noHistory：那个属性会让系统在「离开」时（被遮挡也算）把它 finish 掉，
            登录中途被回收就前功尽弃 —— 与 LockScreenMusicActivity 那边的坑同源。
        -->
        <activity
            android:name=".YtmSignInActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="登录 YouTube Music"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme.NoActionBar" />

        <!--
            音乐锁屏页：系统正式支持的「画在锁屏之上」只能靠 Activity
            （悬浮窗那条路各家 ROM 说了算，见 LockScreenMusicActivity 的说明）。

            showWhenLocked 是清单里的前置声明，代码里的 setShowWhenLocked 是 API 27+ 的开关，
            两个都要有。excludeFromRecents / taskAffinity="" 让它不污染最近任务与返回栈，
            否则用户解锁后会发现多出来一个「Folia 锁屏」卡片。

            这里**不能**加 android:noHistory="true"：它的语义是"用户一旦离开就 finish"，
            而锁屏这个场景里"离开"的判定很微妙（keyguard 重新布局、被其它锁屏界面遮挡
            都算），用户什么都没做，Activity 就被系统自己 finish 了 ——
            表现正是「闪出播放界面，然后突然消失」。不进历史记录靠 excludeFromRecents 就够了。
        -->
        <activity
            android:name=".LockScreenMusicActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:theme="@style/LockScreenTheme" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        局域网音响投送（FoliaLanCastPlugin）：SSDP 设备发现走 UDP 组播，不拿
        WifiManager.MulticastLock 的话不少 ROM 会直接把组播包丢掉，表现是「一台都搜不到」。
        CHANGE_WIFI_MULTICAST_STATE 是拿锁的前提，ACCESS_WIFI_STATE / ACCESS_NETWORK_STATE
        用来取 WiFi 状态与本机所在网段。三个都是 normal 级，安装即授予，无需运行时弹窗。
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 前台服务 + 通知：后台播放时占住前台优先级并在通知栏显示播放控制 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
        电池优化白名单：只用于弹系统那个「是否允许后台运行」对话框
        （ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS，见 keepalive/KeepAlive）。

        没有它的话，那个 action 会被系统当成一次普通跳转静默丢掉 —— 用户点了没反应，
        也就无从判断到底是没授权还是按钮坏了。它**不是**运行时权限，不用申请，
        只是告诉系统「本应用会发起这个请求」。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
        本地曲库扫描：读系统媒体库里的音频必须声明这两个权限，缺了的话
        Capacitor 的 requestPermissionForAlias 会直接判"拒绝"，扫描按钮点了没反应。
        13+ 用 READ_MEDIA_AUDIO，12 及以下用 READ_EXTERNAL_STORAGE（maxSdkVersion 限住，
        两个不能混在同一个别名里申请，见 FoliaNativePlugin.audioPermissionAlias 的说明）。
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!--
        所有文件访问（MANAGE_EXTERNAL_STORAGE）：媒体库扫不到的歌（有的 ROM 不收录、
        用户音乐放在 Download/Music 之外的角落）靠它做文件系统兜底扫描。
        这是"受限权限"，不能靠弹窗给，只能跳系统设置让用户手动开 —— 见
        FoliaNativePlugin.requestAllFilesAccess。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!--
        壁纸的可视化叠层：WallpaperService 本身只能往 Surface 上画 GLES，
        画不了 PixiJS 那套可视化，所以要在壁纸之上叠一个 WebView 窗口来跑同一套渲染代码。
        属于「用户必须手动授权」的权限（设置 → 应用 → 显示在其他应用上层）。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
        应用内更新：下载完 APK 后拉起系统安装器需要 REQUEST_INSTALL_PACKAGES。
        不声明的话 ACTION_VIEW 会被系统直接拦掉（部分 ROM 上表现为点了「安装」毫无反应）。
        注意它只是**声明权限**，Android O+ 还要用户在「允许来自此来源的应用」里给过授权，
        运行时检查见 FoliaNativePlugin.installUpdate。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
        壁纸叠层的音频采集：叠层是独立 WebView，拿不到主应用那个 AnalyserNode，
        只能用 android.media.audiofx.Visualizer 的 session 0（全局混音）去抓频谱，
        否则莫奈的「音频图案」在叠层上永远是死的。
        这是 **normal 级权限**，装的时候就给了，不需要运行时弹窗。
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
        HDR 投影「真的把系统亮度顶满」：窗口级覆盖（BRIGHTNESS_OVERRIDE_FULL）只对我们
        自己的窗口有效，设置里那个滑块一动不动，带自动亮度 / 阳光屏的 ROM 还会把它压回去。
        这是「特殊权限」，装的时候不给，得用户在系统设置里开一次（设置 → 应用 → 权限 →
        修改系统设置）；没给的话投影只走窗口覆盖那一条，界面上会提示。
        tools:ignore 是因为 lint 对所有 protected 权限都报 ProtectedPermissions。
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
