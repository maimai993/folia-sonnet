{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel-api",
  "outputDirectory": "public",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)docs/CODEMAP.md'",
  "rewrites": [
    { "source": "/api/qq/:path*", "destination": "/api/qq?path=/:path*" }
  ]
}
