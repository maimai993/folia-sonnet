# 当前文件：Folia Docker Compose 的用户配置模板。
FOLIA_IMAGE_NAMESPACE=papersman

FOLIA_HTTP_BIND=0.0.0.0
FOLIA_HTTP_PORT=18080
FOLIA_AI_PROVIDER=google
FOLIA_FORWARD_CLIENT_IP=false
ENABLE_GENERAL_UNBLOCK=false

# 同时填写这两项后，QQ 登录态会加密保存到 qq-api-state 卷并跨重启恢复。
QQ_AUTH_SESSION_PATH=
QQ_SESSION_SECRET=

# 三项都填后，新打开的浏览器会自动登录这个 Navidrome；地址必须是浏览器能直接访问的地址。
# 能打开这个 Folia 页面的人都能读到这组凭据，建议用一个专门的 Navidrome 账号。
NAVIDROME_URL=
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
# 允许读取预置凭据的来源，逗号分隔的 IP/CIDR；private 表示局域网（默认），any 表示不限制。
NAVIDROME_PRESET_ALLOW=private
# Folia 前面还有反向代理时填代理的 IP/CIDR，否则局域网限制看到的永远是代理地址。
FOLIA_TRUSTED_PROXIES=

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o
OPENAI_API_TEMPERATURE=0.7

FOLIA_SYNC_BIND=0.0.0.0
FOLIA_SYNC_PORT=13000
FOLIA_SYNC_DATA_DIR=./data/sync
SYNC_TOKEN=
DASHBOARD_TOKEN=
